{
  "compilerOptions": {
    "target": "ES6",
    "module": "Node16",
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "sourceMap": true,
    "outDir": "dist",
    "rootDir": "src",
    "jsx": "react-jsx",
    "moduleResolution": "Node16",
    "resolveJsonModule": true
  },
  "include": ["src/**/*"]
}
